# Netlify AI Gateway injects GEMINI_API_KEY and GOOGLE_GEMINI_BASE_URL automatically in production & `netlify dev`.
# Optional overrides:
# GEMINI_MODEL=gemini-3.8-flash
# AI_DAILY_LIMIT=30

# Official Google Cloud Text-to-Speech API key (optional; audio is cached in Netlify Blobs, falls back to Web Speech API if unset)
# GOOGLE_CLOUD_TTS_API_KEY=
